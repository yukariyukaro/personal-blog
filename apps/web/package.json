{
  "name": "@lousuxing/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "check:size": "node scripts/quality/check-file-lines.mjs",
    "test:unit": "node --test scripts/**/*.test.mjs && vitest run src",
    "check": "pnpm run check:size && pnpm run lint && pnpm run test:unit && pnpm run build",
    "content:build": "node scripts/build-content.mjs",
    "content:build:dev": "node scripts/build-content.mjs --include-drafts",
    "dev": "pnpm run content:build:dev && vite",
    "build": "pnpm run content:build && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:report": "playwright show-report output/playwright/blog-acceptance-report"
  },
  "dependencies": {
    "@lobehub/icons": "^5.2.0",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/themes": "^3.3.0",
    "hls.js": "^1.6.15",
    "install": "^0.13.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router": "^7.13.2",
    "react-router-dom": "^7.13.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "gray-matter": "^4.0.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vite-plugin-pages": "^0.33.3",
    "vitest": "^5.0.0"
  }
}
